# Inject these environment variables through your shell, IDE or container.
LISTEN=127.0.0.1
PORT=8080
IO_THREADS=2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=disk
DB_USER=disk
DB_PASSWORD=replace-with-your-password
JWT_ISSUER=disk
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
STORAGE_ADDRESS=127.0.0.1:50051
UPLOAD_MAX_BYTES=1073741824
REQUEST_TIMEOUT_SECONDS=1800
# Optional when the frontend uses the Vite development proxy.
# CORS_ALLOWED_ORIGIN=http://localhost:5173
# STORAGE_TLS_CA=/path/to/ca.pem
# STORAGE_TLS_CLIENT_CERT=/path/to/client.pem
# STORAGE_TLS_CLIENT_KEY=/path/to/client-key.pem
# STORAGE_TLS_SERVER_NAME=storage.internal
