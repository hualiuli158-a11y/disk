LISTEN=127.0.0.1
PORT=8080
APP_ENV=production
# HTTP 请求与优雅停机边界；大文件上传/下载需保留足够的读写时间。
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30m
HTTP_WRITE_TIMEOUT=30m
HTTP_IDLE_TIMEOUT=2m
HTTP_MAX_HEADER_BYTES=65536
HTTP_SHUTDOWN_TIMEOUT=30s
# 后台清理使用独立的短停机等待时间，不受 STORAGE_TIMEOUT 影响。
CLEANUP_SHUTDOWN_TIMEOUT=5s

# 仅信任本机 Nginx 写入的 X-Forwarded-For；多地址使用逗号分隔。
TRUSTED_PROXIES=127.0.0.1,::1
AUTH_RATE_PER_MINUTE=20
AUTH_RATE_BURST=5
LOGIN_FAILURE_LIMIT=5
LOGIN_BLOCK_DURATION=5m
UPLOAD_RATE_PER_MINUTE=30
UPLOAD_RATE_BURST=3
SEARCH_RATE_PER_MINUTE=120
SEARCH_RATE_BURST=20
UPLOAD_MAX_BYTES=1073741824
UPLOAD_MULTIPART_OVERHEAD_BYTES=1048576
UPLOAD_CONCURRENT_PER_USER=2

DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1:3306
DB_NAME=disk

# Generate with `openssl rand -hex 32`; inject through a deployment Secret.
# Set exactly one of JWT_SECRET or JWT_SECRET_FILE. A mounted Secret file is preferred.
JWT_SECRET_FILE=/run/secrets/disk_jwt_secret
# JWT_SECRET=
JWT_ISSUER=disk
JWT_EXPIRE=15m

# Exact origins only; wildcard origins are not supported.
CORS_ALLOWED_ORIGINS=https://disk.example.com
# Swagger defaults to disabled in production. If enabled, both credentials are required.
SWAGGER_ENABLED=false
# SWAGGER_USERNAME=operations
# SWAGGER_PASSWORD_FILE is not supported; inject SWAGGER_PASSWORD as a deployment Secret.
# SWAGGER_PASSWORD=

STORAGE_ROOT=data
# local or grpc
STORAGE_BACKEND=local
# Used only for grpc
STORAGE_ADDRESS=127.0.0.1:50051
STORAGE_TIMEOUT=30m
# For TLS, set CA and the expected certificate server name. Client cert/key enable mTLS.
# STORAGE_TLS_CA=/path/to/ca.pem
# STORAGE_TLS_SERVER_NAME=storage.example.internal
# STORAGE_TLS_CLIENT_CERT=/path/to/client.pem
# STORAGE_TLS_CLIENT_KEY=/path/to/client.key
STORAGE_CLEANUP_INTERVAL=6h
STORAGE_ORPHAN_GRACE=24h
STORAGE_CLEANUP_BATCH=1000
