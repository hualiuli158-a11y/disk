    "/api/files": {
      "post": {
        "tags": [
          "文件"
        ],
        "operationId": "uploadFile",
        "summary": "上传文件",
        "description": "每次上传一个文件。multipart 请求体中的 folder_id 必须是第一部分，file 必须是第二部分。",
        "parameters": [
          {
            "name": "X-Upload-Size",
            "in": "header",
            "description": "可选，声明文件字节数。声明值必须与实际内容大小一致。",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "folder_id",
                  "file"
                ],
                "properties": {
                  "folder_id": {
                    "$ref": "#/components/schemas/Id"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传文件",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadedFile"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "$ref": "#/components/responses/Timeout"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "502": {
            "$ref": "#/components/responses/StorageProtocolError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/StorageTimeout"
          },
          "507": {
            "$ref": "#/components/responses/QuotaExceeded"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/api/files/{id}/download": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": [
          "文件"
        ],
        "operationId": "downloadFile",
        "summary": "下载文件",
        "responses": {
          "200": {
            "description": "文件的二进制内容",
            "headers": {
              "ETag": {
                "description": "加引号的 SHA-256",
                "schema": {
                  "type": "string"
                }
              },
              "X-File-SHA256": {
                "description": "文件内容的 SHA-256",
                "schema": {
                  "$ref": "#/components/schemas/Sha256"
                }
              },
              "Content-Disposition": {
                "description": "附件文件名",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/StorageProtocolError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/StorageTimeout"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
