{
  "openapi": "3.0.3",
  "info": {
    "title": "Disk API",
    "version": "0.1.0",
    "description": "Disk C++ 后端。登录或注册后，将返回的 access_token 填入 Authorize 以调用受保护接口。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "健康检查"
    },
    {
      "name": "账号"
    },
    {
      "name": "目录"
    },
    {
      "name": "文件"
    },
    {
      "name": "搜索"
    },
    {
      "name": "回收站"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/livez": {
      "get": {
        "tags": [
          "健康检查"
        ],
        "operationId": "checkLiveness",
        "summary": "检查 API 是否存活",
        "security": [],
        "responses": {
          "200": {
            "description": "检查 API 是否存活",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "alive"
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "健康检查"
        ],
        "operationId": "checkReadiness",
        "summary": "检查 MySQL 和对象存储",
        "security": [],
        "responses": {
          "200": {
            "description": "检查 MySQL 和对象存储",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "504": {
            "$ref": "#/components/responses/StorageTimeout"
          },
          "default": {
            "$ref": "#/components/responses/UnexpectedError"
          }
        }
      }
    },
    "/register": {
