include(FetchContent)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(BOTAN_SOURCE_DIR "${CMAKE_SOURCE_DIR}/build/sources/botan-3.10.0" CACHE PATH "Botan source")
set(JWT_SOURCE_DIR "${CMAKE_SOURCE_DIR}/build/sources/jwt-cpp-0.7.1" CACHE PATH "jwt-cpp source")
if(NOT EXISTS "${BOTAN_SOURCE_DIR}/configure.py")
    FetchContent_Declare(botan_source URL https://codeload.github.com/randombit/botan/zip/refs/tags/3.10.0
        URL_HASH SHA256=93c665e2de6c419bba36312140a63418d7aa34c0d90bb97cc4786fd28b44ac75 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(botan_source)
    set(BOTAN_SOURCE_DIR "${botan_source_SOURCE_DIR}")
endif()
if(NOT EXISTS "${JWT_SOURCE_DIR}/include/jwt-cpp/jwt.h")
    FetchContent_Declare(jwt_source URL https://codeload.github.com/Thalhammer/jwt-cpp/zip/refs/tags/v0.7.1
        URL_HASH SHA256=73592935b361a669c01402abc5f8624b917eb20733cecdd41fd91c1a150393b6 DOWNLOAD_EXTRACT_TIMESTAMP TRUE SOURCE_SUBDIR unused)
    FetchContent_MakeAvailable(jwt_source)
    set(JWT_SOURCE_DIR "${jwt_source_SOURCE_DIR}")
endif()
set(botan_build "${CMAKE_BINARY_DIR}/botan")
file(MAKE_DIRECTORY "${botan_build}")
set(botan_platform)
if(MINGW)
    list(APPEND botan_platform --cc=gcc --cc-bin=${CMAKE_CXX_COMPILER} --os=mingw)
elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    list(APPEND botan_platform --cc=clang --cc-bin=${CMAKE_CXX_COMPILER})
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    list(APPEND botan_platform --cc=gcc --cc-bin=${CMAKE_CXX_COMPILER})
endif()
if(NOT EXISTS "${botan_build}/botan_all.cpp")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${BOTAN_SOURCE_DIR}/configure.py"
    --amalgamation --minimized-build --enable-modules=bcrypt,auto_rng,system_rng
    --disable-shared-library --with-build-dir=${botan_build} ${botan_platform}
    WORKING_DIRECTORY "${botan_build}" COMMAND_ERROR_IS_FATAL ANY)
endif()
add_library(disk_botan STATIC "${botan_build}/botan_all.cpp")
target_include_directories(disk_botan PUBLIC "${botan_build}")
if(WIN32)
    target_link_libraries(disk_botan PRIVATE bcrypt)
endif()
set(MULTIPART_SOURCE_DIR "${CMAKE_SOURCE_DIR}/third_party/multipart" CACHE PATH "multipart-parser-c source")
if(NOT EXISTS "${MULTIPART_SOURCE_DIR}/multipart_parser.c")
    FetchContent_Declare(multipart_source URL https://codeload.github.com/iafonov/multipart-parser-c/zip/refs/heads/master DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(multipart_source)
    set(MULTIPART_SOURCE_DIR "${multipart_source_SOURCE_DIR}")
endif()
add_library(disk_multipart STATIC "${MULTIPART_SOURCE_DIR}/multipart_parser.c")
target_include_directories(disk_multipart PUBLIC "${MULTIPART_SOURCE_DIR}")
